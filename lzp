#!/usr/bin/env bash

#INFO: zlp - launcher + wrapper for zsh completion LSP
# Usage: executed by nvim lspconfig (no args); the LSP server will spawn this.
# It sets ZSH_COMPLETION_SCRIPT and execs the Node server. When invoked by the Node server,
# it forwards the single argument to the real completion script.

# Adjust these paths to your setup:
LZP_PROJECT_DIR="${LZP_PROJECT_DIR:-${HOME}/projects/lzp}"
LZP_CAPTURE_SCRIPT="${LZP_COMPLETION_SCRIPT_PATH:-${LZP_PROJECT_DIR}/capture.zsh}"
LZP_NODE_SERVER="${LZP_NODE_SERVER:-${LZP_PROJECT_DIR}/server.js}"

# If invoked with zero args -> act as launcher for the LSP (start Node server)
if [[ $# -eq 0 ]]; then
    exec node "${LZP_NODE_SERVER}"
fi

# If invoked with an arg -> act as wrapper forwarding to the real completion script.
# Preserve the argument (it includes backspaces sequence produced by server).
if [[ ! -x "${LZP_CAPTURE_SCRIPT}" ]]; then
    echo "error: completion script not executable: ${LZP_CAPTURE_SCRIPT}" >&2
    exit 1
fi

# Forward single argument and pipe stdin through
exec "${LZP_CAPTURE_SCRIPT}" "$1"
